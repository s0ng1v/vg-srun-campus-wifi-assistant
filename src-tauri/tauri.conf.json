{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VG校园网助手",
  "version": "0.1.7",
  "identifier": "io.github.v1gn0s.vg-campus-wifi-assistant",
  "build": {
    "beforeDevCommand": "npm run dev:renderer",
    "beforeBuildCommand": "npm run build:renderer",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist",
    "windows": {
      "staticVCRuntime": true
    }
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "VG校园网助手",
      "width": 1170,
      "height": 780,
      "minWidth": 900,
      "minHeight": 600,
      "maxWidth": 1600,
      "maxHeight": 900,
      "center": true,
      "decorations": false,
      "visible": true,
      "resizable": false,
      "maximizable": false
    }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
